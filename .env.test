# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
JWT_PASSPHRASE=
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"
# Keep automated tests independent from RabbitMQ and the PHP AMQP extension.
# Keep dispatched messages available for assertions without executing them in
# the HTTP request; production uses the existing async AMQP transport.
MESSENGER_TRANSPORT_DSN=in-memory://
